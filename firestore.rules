rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Each user can only read/write their own journal entries
    match /users/{userId}/entries/{entryId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Public username registry for uniqueness (doc id is the normalized username)
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // Per-user profile with required displayName + username
    match /users/{userId}/profile/{profileId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.username.matches('^[a-z0-9._]+$')
        && exists(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
        && (!exists(resource.path) || resource.data.username == request.resource.data.username);
    }
  }
}
